    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  }
}
